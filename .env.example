# Discord
DISCORD_TOKEN=your_discord_bot_token

# Gemini (comma-separated for key rotation)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.0-flash
GEMINI_CONTEXT_LIMIT=1048576
GEMINI_OUTPUT_LIMIT=65536

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_HEAVY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Tavily
TAVILY_API_KEY=your_tavily_api_key

# Browserless (optional - for webpage fetching)
BROWSERLESS_URL=https://your-browserless-service.com
BROWSERLESS_TOKEN=your_browserless_token

# Hyperbrowser (optional - alternative/fallback fetch provider)
HYPERBROWSER_API_KEY=your_hyperbrowser_key
# hyperbrowser | browserless | auto (default auto: hyperbrowser dulu, fallback browserless)
FETCH_PROVIDER=auto

# Compaction
COMPACTION_THRESHOLD=0.80
COMPACTION_TARGET=0.20

# Micro-RAG Nuggets
NUGGETS_TTL_DAYS=3
NUGGETS_TOP_K=5

# Bot Behavior
BOT_PREFIX=n!,.,?
BOT_REPLY_MENTION=true
PROCESS_REPLY_WITHOUT_MENTION=false
SESSION_TIMEOUT=3600

# GitHub Backup (optional)
BACKUP_ENABLED=false
GITHUB_BACKUP_REPO=
# Alias lama yang masih didukung: GITHUB_REPO (dipakai bila GITHUB_BACKUP_REPO kosong)
GITHUB_TOKEN=

# Scheduled Jobs
TTL_PRUNE_DAYS=30
HISTORY_CLEANUP_DAYS=7

# Auto-Mention (optional)
WELCOME_ENABLED=false
WELCOME_CHANNEL_ID=0
